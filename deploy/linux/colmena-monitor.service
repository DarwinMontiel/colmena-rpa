[Unit]
Description=Colmena RPA · monitor (API + panel de operación)
After=network-online.target

[Service]
Type=simple
User=colmena
WorkingDirectory=/opt/colmena-rpa
EnvironmentFile=/etc/colmena-rpa/monitor.env
Environment=RPA_MONITOR_HOST=127.0.0.1
Environment=RPA_MONITOR_PORT=8000
ExecStart=/opt/colmena-rpa/.venv/bin/colmena-monitor
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
