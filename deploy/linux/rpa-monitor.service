[Unit]
Description=RPA Orchestrator monitor (API + dashboard)
After=network-online.target

[Service]
Type=simple
User=rpa
WorkingDirectory=/opt/rpa-orchestrator
EnvironmentFile=/etc/rpa-orchestrator/monitor.env
Environment=RPA_MONITOR_HOST=127.0.0.1
Environment=RPA_MONITOR_PORT=8000
ExecStart=/opt/rpa-orchestrator/.venv/bin/rpa-monitor
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
