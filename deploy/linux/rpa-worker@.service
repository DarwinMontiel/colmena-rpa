# Worker como servicio systemd (plantilla: varias instancias por servidor).
#   sudo cp deploy/linux/rpa-worker@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rpa-worker@1 rpa-worker@2
#   journalctl -u rpa-worker@1 -f
[Unit]
Description=RPA Orchestrator worker %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rpa
Group=rpa
WorkingDirectory=/opt/rpa-orchestrator
EnvironmentFile=/etc/rpa-orchestrator/worker.env
Environment=RPA_WORKER_ID=%H-worker-%i
ExecStart=/opt/rpa-orchestrator/.venv/bin/rpa-worker
# Parada ordenada: SIGTERM -> el worker termina la tarea en curso y confirma el mensaje.
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=always
RestartSec=5
# Endurecimiento
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
