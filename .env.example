# Copiar a .env y ajustar. Todas las variables usan el prefijo RPA_.
RPA_DATABASE_URL=postgresql+psycopg://rpa:rpa@localhost:5432/rpa
RPA_AMQP_URL=amqp://guest:guest@localhost:5672/%2F
RPA_EXCHANGE=rpa.tasks

# Worker
RPA_PROCESSES=["payment_agreement"]
RPA_PREFETCH_COUNT=1
RPA_MAX_ATTEMPTS=4
RPA_RETRY_DELAYS_SECONDS=[10,60,300]
RPA_HEARTBEAT_INTERVAL_SECONDS=15
RPA_ARTIFACTS_DIR=artifacts

# Monitor
RPA_OFFLINE_AFTER_SECONDS=60

# Portal operado por el bot (demo incluida en el repositorio)
RPA_PORTAL_URL=http://localhost:8001
RPA_PORTAL_USER=bot
RPA_PORTAL_PASSWORD=bot-demo
RPA_HEADLESS=true

# Logs
RPA_LOG_LEVEL=INFO
RPA_LOG_JSON=true
